#=============================================================================
# Git Submodules Plugin - Zsh Completion
# Provides tab completion for all commands and flags
#=============================================================================

# Standard flags available for all commands
_git_submodules_standard_flags() {
    local -a flags
    flags=(
        '(-h --help)'{-h,--help}'[Show help for command]'
        '(-n --dry-run)'{-n,--dry-run}'[Preview without executing]'
        '(-q --quiet)'{-q,--quiet}'[Minimal output]'
        '(-v --verbose)'{-v,--verbose}'[Detailed output]'
        '(-j --json)'{-j,--json}'[JSON output format]'
        '(-p --parallel)'{-p,--parallel}'[Use parallel execution]'
        '--jobs[Number of parallel jobs]:jobs:(2 4 8 16)'
        '(-f --force)'{-f,--force}'[Skip confirmations]'
        '(-y --yes)'{-y,--yes}'[Auto-confirm prompts]'
        '--scope[Target repositories]:scope:(base subs all)'
    )
    _arguments $flags
}

# Branch name completion
_git_submodules_branches() {
    local -a branches
    branches=(${(f)"$(git branch -a 2>/dev/null | sed 's/^[* ]*//' | sed 's#^remotes/origin/##')"})
    _describe 'branch' branches
}

# Submodule path completion
_git_submodules_submodules() {
    local -a submodules
    submodules=(${(f)"$(git submodule status 2>/dev/null | awk '{print $2}')"})
    _describe 'submodule' submodules
}

# Config keys completion
_git_submodules_config_keys() {
    local -a keys
    keys=(
        'parallel_enabled:Enable parallel execution'
        'parallel_jobs:Number of parallel jobs'
        'menu_style:Menu interaction style'
        'progress_style:Progress indicator style'
        'emoji_enabled:Enable emoji output'
        'atomic_commits:Enable atomic commits'
        'dry_run_default:Default to dry-run mode'
        'confirm_destructive:Confirm destructive operations'
        'cache_enabled:Enable caching'
        'cache_ttl:Cache TTL in seconds'
        'verbose_mode:Enable verbose output'
        'quiet_mode:Enable quiet mode'
        'auto_stash:Auto-stash before operations'
    )
    _describe 'config key' keys
}

# Completion for pull_all
_git_submodules_pull_all() {
    _git_submodules_standard_flags
}

# Completion for push_all
_git_submodules_push_all() {
    _git_submodules_standard_flags
}

# Completion for add_all
_git_submodules_add_all() {
    _git_submodules_standard_flags
}

# Completion for commit_all
_git_submodules_commit_all() {
    _arguments \
        '(-h --help)'{-h,--help}'[Show help]' \
        '(-n --dry-run)'{-n,--dry-run}'[Preview without executing]' \
        '(-q --quiet)'{-q,--quiet}'[Minimal output]' \
        '(-v --verbose)'{-v,--verbose}'[Detailed output]' \
        '--scope[Target repositories]:scope:(base subs all)' \
        '1:commit message:'
}

