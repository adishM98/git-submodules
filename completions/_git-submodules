# Main completion dispatcher
_git-submodules() {
    local curcontext="$curcontext" state line
    typeset -A opt_args

    case "$words[1]" in
        pull_all)
            _git_submodules_pull_all
            ;;
        push_all)
            _git_submodules_push_all
            ;;
        add_all)
            _git_submodules_add_all
            ;;
        commit_all)
            _git_submodules_commit_all
            ;;
        status_all)
            _git_submodules_status_all
            ;;
        checkout_all)
            _git_submodules_checkout_all
            ;;
        merge_all)
            _git_submodules_merge_all
            ;;
        create_branch_all)
            _git_submodules_create_branch_all
            ;;
        create_feature_all|start_feature)
            _git_submodules_create_feature_all
            ;;
        create_hotfix_all|start_hotfix)
            _git_submodules_create_hotfix_all
            ;;
        create_release_all|start_release)
            _git_submodules_create_release_all
            ;;
        create_tag_all)
            _git_submodules_create_tag_all
            ;;
        smart_commit_all)
            _git_submodules_smart_commit_all
            ;;
        *)
            _git_submodules_standard_flags
            ;;
    esac
}

# Register completion for each command
compdef _git_submodules_pull_all pull_all
compdef _git_submodules_push_all push_all
compdef _git_submodules_add_all add_all
compdef _git_submodules_commit_all commit_all
